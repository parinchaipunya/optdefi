\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{optproblem}[2026/04/03 optimization problem definition]

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{empheq}
\RequirePackage{eqparbox}
\RequirePackage{environ}

\newcounter{OptEnv}
\newcounter{ConsNum}

% --- Alignment Toggle Logic ---
\newif\ifalignrel
\alignrelfalse % Default: Left-aligned

% Internal command to handle the alignment tabs
% We define this as a macro that expands to either one or two tabs
\newcommand{\@opt@tab}{&}

% User commands to switch modes
\newcommand{\alignrelations}{%
  \alignreltrue
  \renewcommand{\@opt@tab}{&&}%
}
\newcommand{\alignleft}{%
  \alignrelfalse
  \renewcommand{\@opt@tab}{}%
}

% --- Environments ---
\NewEnviron{optim}{%
  \stepcounter{OptEnv}
  \setcounter{ConsNum}{0}
  \begin{empheq}[left=\empheqlbrace\;]{alignat=4}
    \BODY
  \end{empheq}
}

\NewEnviron{optim*}{%
  \stepcounter{OptEnv}
  \setcounter{ConsNum}{0}
  \begin{empheq}[left=\empheqlbrace\;]{alignat*=4}
    \BODY
  \end{empheq}
}

\NewEnviron{optimunc}{%
  \begin{align}
    \BODY
  \end{align}
}

\NewEnviron{optimunc*}{%
  \begin{align*}
    \BODY
  \end{align*}
}

% --- Operators and Labels ---
\DeclareMathOperator*{\argmin}{arg\,min}
\DeclareMathOperator*{\argmax}{arg\,max}
\DeclareMathOperator*{\minormax}{\min \big/ \max}

\newcommand{\subjto}{\small\text{s.t.}}
\newcommand{\Subjto}{\\ \eqmakebox[OE\arabic{OptEnv}][c]{$\subjto$} \quad }
\newcommand{\chk}{\ifnum\value{ConsNum}>0 \\ \else \Subjto \fi}

% --- Core Commands ---
\newcommand{\setObj}[3]{%
  \eqmakebox[OE\arabic{OptEnv}][c]{$\displaystyle #1_{#2}$} \quad & #3 
}

\newcommand{\addCons}[1]{%
  \chk
  & {#1}
  \addtocounter{ConsNum}{1}
}

\newcommand{\addEqCons}[2]{%
  \chk
  & {#1} \@opt@tab = {#2}
  \addtocounter{ConsNum}{1}
}

\newcommand{\addIneqCons}[2]{%
  \chk
  & {#1} \@opt@tab \leq {#2}
  \addtocounter{ConsNum}{1}
}

\newcommand{\addLbCons}[2]{%
  \chk
  & {#1} \@opt@tab \geq {#2}
  \addtocounter{ConsNum}{1}
}

\newcommand{\addInclCons}[2]{%
  \chk
  & {#1} \@opt@tab \in {#2}
  \addtocounter{ConsNum}{1}
}

\newcommand{\addBddCons}[3]{%
  \chk
  & {#2} \leq {#1} \leq {#3}
  \addtocounter{ConsNum}{1}
}

\newcommand{\addvdots}{%
  \chk
  & {} \@opt@tab \;\, \vdots {}
  \addtocounter{ConsNum}{1}
}
